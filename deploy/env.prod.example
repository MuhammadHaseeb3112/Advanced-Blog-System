# Copy to deploy/.env.prod on the server and fill in. Never commit .env.prod.

# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_DB=blog
POSTGRES_USER=blog

# Your domain (no https:// in ALLOWED_HOSTS, with https:// in CSRF_TRUSTED_ORIGINS).
# Keep localhost: the container health check uses it.
ALLOWED_HOSTS=blog.example.com,localhost
CSRF_TRUSTED_ORIGINS=https://blog.example.com
SECURE_COOKIES=True

# Public demo: one-click demo logins, demo data on first start, no outgoing
# email, account changes off. Set to False for a real site and fill in EMAIL_*.
DEMO_MODE=True

# Email (only used when DEMO_MODE=False)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
